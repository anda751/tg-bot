{
  "kind": "collectionType",
  "collectionName": "project_memberships",
  "info": {
    "singularName": "project-membership",
    "pluralName": "project-memberships",
    "displayName": "Project Membership"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "membershipStatus": {
      "type": "enumeration",
      "enum": [
        "Requested",
        "Member"
      ]
    },
    "project": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project",
      "inversedBy": "Project"
    },
    "member": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
