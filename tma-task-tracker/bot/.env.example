# ============================================================
# bot/.env.example  →  copy to .env and fill in values
# ============================================================

# Telegram
BOT_TOKEN=your_bot_token_here
BOT_WEBHOOK_SECRET=random_secret_string_for_webhook_validation

# Webhook URL (your deployed bot URL)
WEBHOOK_URL=https://your-bot.railway.app/webhook

# Strapi
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your_strapi_full_access_api_token

# Supabase (for direct storage signed URL generation if needed)
SUPABASE_URL=https://thzlubnipqkogdqwtuql.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Telegram Group Chat ID (main group where bot announces)
TELEGRAM_GROUP_CHAT_ID=-1001234567890

# App
NODE_ENV=development
PORT=3000
TZ=Asia/Bangkok
